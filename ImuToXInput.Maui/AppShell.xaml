<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ImuToXInput.Maui.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:ImuToXInput.Maui"
       Title="ImuToXInput">
    <ShellContent Title="Profiles" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    <ShellContent Title="Shared configs" ContentTemplate="{DataTemplate local:SharedConfigsPage}" Route="SharedConfigs" />
    <ShellContent Title="Tracker angles" ContentTemplate="{DataTemplate local:TrackerDebugPage}" Route="TrackerAngles" />
</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImuToXInput.Maui.ConditionEditPage"
             Title="Edit condition">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12" x:Name="RootLayout">
            <Label Text="Condition type" />
            <Picker x:Name="PickerType" Title="Type" />
            <Label Text="Parameters" />
            <VerticalStackLayout x:Name="PanelFields" Spacing="8" />
            <Label x:Name="LblMapToButton" Text="Map to button" IsVisible="False" Margin="0,12,0,0" />
            <Picker x:Name="PickerMapToButton" Title="Button" IsVisible="False" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button x:Name="BtnOk" Text="OK" Clicked="OnOkClicked" />
                <Button x:Name="BtnCancel" Text="Cancel" Clicked="OnCancelClicked" Grid.Column="1" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImuToXInput.Maui.DongleConnectPage"
             Title="Joypad WiFi">
    <ScrollView>
        <VerticalStackLayout Spacing="16">
            <VerticalStackLayout.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="20,80,20,20" />
                    <On Platform="WinUI" Value="20" />
                    <On Platform="Default" Value="20" />
                </OnPlatform>
            </VerticalStackLayout.Padding>
            <Label Text="Send controller input to Joypad OS over WiFi (JOCP)." FontSize="14" TextColor="#555" />
            <Label x:Name="LblJocpStatus" Text="Not connected" FontSize="14" TextColor="#555" />
            <!-- Host on its own row so the IP entry has full width and avoids cramped/overlapping text on Android -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Host (e.g. 192.168.4.1)" FontSize="12" TextColor="#666" />
                <Entry x:Name="EntryJocpHost" Placeholder="192.168.4.1" Keyboard="Numeric" Text="192.168.4.1"
                       HeightRequest="48" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="Port" FontSize="12" TextColor="#666" />
                <Entry x:Name="EntryJocpPort" Placeholder="30100" Keyboard="Numeric" Text="30100"
                       HeightRequest="48" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="BtnJocpConnect" Text="Connect" Clicked="OnJocpConnectClicked" />
                <Button x:Name="BtnJocpDisconnect" Text="Disconnect" Clicked="OnJocpDisconnectClicked" IsVisible="False" />
            </Grid>
            <Label x:Name="LblJocpHint" Text="Connect phone to Joypad's WiFi AP, then enter dongle IP (often 192.168.4.1) and Connect." FontSize="12" TextColor="#888" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

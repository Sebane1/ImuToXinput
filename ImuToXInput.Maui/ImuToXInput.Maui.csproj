<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ImuToXInput.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>ImuToXInput</ApplicationTitle>
    <ApplicationId>com.imutoxinput.maui</ApplicationId>
    <!-- Suppress "workload out of support" when using net10.0 + MAUI workload -->
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Don't break in generated App.g.i.cs on unhandled exception; exception still propagates -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>
  <!-- Workaround for Windows App SDK: publish needs RuntimeIdentifierOverride so RID is applied when publishing unpackaged. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Unconditional IsPublishable so Visual Studio enables Publish (right-click project → Publish). Use Folder profile for standalone Windows exe. -->
  <PropertyGroup>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <!-- Explicit MAUI packages required for Android (workload alone can miss assemblies/Glide). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.31" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.31" />
    <!-- Theme.MaterialComponents required for TextAppearance (e.g. Material buttons). -->
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.5" Condition="$(TargetFramework.Contains('android'))" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImuToXInput.Core\ImuToXInput.Core.csproj" />
    <ProjectReference Include="..\SlimeImuProtocol\SlimeImuProtocol.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Zeroconf" Version="3.7.16" />
  </ItemGroup>

  <!-- Exclude platform folders when not building for that platform -->
  <ItemGroup Condition="$(TargetFramework.Contains('android')) == false">
    <Compile Remove="Platforms\Android\**\*.cs" />
    <None Include="Platforms\Android\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('windows')) == false">
    <Compile Remove="Platforms\Windows\**\*.cs" />
    <None Include="Platforms\Windows\**\*.cs" />
  </ItemGroup>

  <!-- Bundled configs: copied to app config folder on first run if missing -->
  <ItemGroup>
    <EmbeddedResource Include="BundledConfigs\*.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="BundledConfigs\MirrorsEdge.json" />
    <EmbeddedResource Remove="BundledConfigs\portal.json" />
  </ItemGroup>
  <ItemGroup>
    <None Update="BundledConfigs\MirrorsEdge.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="BundledConfigs\portal.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

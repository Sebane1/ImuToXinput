<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ImuToXInput.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>ImuToXInput</ApplicationTitle>
    <ApplicationId>com.imutoxinput.maui</ApplicationId>
    <!-- Suppress "workload out of support" when using net10.0 + MAUI workload -->
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Don't break in generated App.g.i.cs on unhandled exception; exception still propagates -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>

  <!-- Explicit MAUI packages required for Android (workload alone can miss assemblies/Glide). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.31" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.31" />
    <!-- Theme.MaterialComponents required for TextAppearance (e.g. Material buttons). -->
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.5" Condition="$(TargetFramework.Contains('android'))" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImuToXInput.Core\ImuToXInput.Core.csproj" />
    <ProjectReference Include="..\SlimeImuProtocol\SlimeImuProtocol.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Exclude platform folders when not building for that platform -->
  <ItemGroup Condition="$(TargetFramework.Contains('android')) == false">
    <Compile Remove="Platforms\Android\**\*.cs" />
    <None Include="Platforms\Android\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('windows')) == false">
    <Compile Remove="Platforms\Windows\**\*.cs" />
    <None Include="Platforms\Windows\**\*.cs" />
  </ItemGroup>
</Project>

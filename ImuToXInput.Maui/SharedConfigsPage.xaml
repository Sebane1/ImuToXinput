<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:ImuToXInput.Maui.Services"
             x:Class="ImuToXInput.Maui.SharedConfigsPage"
             Title="Shared configs">
    <ScrollView>
        <VerticalStackLayout Spacing="16">
            <VerticalStackLayout.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="20,80,20,20" />
                    <On Platform="Default" Value="20" />
                </OnPlatform>
            </VerticalStackLayout.Padding>
            <Label Text="Search and download community configs, or share one of yours."
                   FontSize="14" TextColor="#555" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar x:Name="SearchBar" Placeholder="Game or config name..."
                           SearchButtonPressed="OnSearchPressed" Grid.Column="0" />
                <Button x:Name="BtnSearch" Text="Search" Clicked="OnSearchPressed" Grid.Column="1" VerticalOptions="Center" />
            </Grid>
            <ActivityIndicator x:Name="Loading" IsVisible="False" IsRunning="False" />
            <Label x:Name="LblEmpty" Text="Enter a search term and tap Search, or leave empty for all."
                   FontSize="13" TextColor="#888" IsVisible="True" />
            <CollectionView x:Name="ListResults" SelectionMode="None" IsVisible="False"
                            MinimumHeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:SharedConfigListItem">
                        <Grid Padding="12,10" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding GameName}" FontAttributes="Bold" FontSize="14" />
                                <Label Text="{Binding ConfigName}" FontSize="12" TextColor="#666" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Download" CommandParameter="{Binding Id}"
                                    Clicked="OnDownloadClicked" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <BoxView HeightRequest="1" Color="#eee" />
            <Label Text="Share a config" FontAttributes="Bold" FontSize="16" />
            <Label Text="Upload one of your local profiles to the shared library."
                   FontSize="13" TextColor="#555" />
            <Button x:Name="BtnUpload" Text="Upload a profile…" Clicked="OnUploadClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImuToXInput.Maui.TriggerAxisEditPage"
             Title="Edit axis trigger">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Tracker" />
            <Picker x:Name="PickerTracker" Title="Select tracker" />
            <Label Text="Source" />
            <Picker x:Name="PickerSource" Title="Select source" />
            <Label Text="Scale (e.g. 1 or 0.5)" />
            <Entry x:Name="EntryScale" Keyboard="Numeric" Placeholder="1" />
            <Label Text="Deadzone (0–1, blank = default 0.2)" />
            <Entry x:Name="EntryDeadzone" Keyboard="Numeric" Placeholder="0.2" />
            <Label Text="Invert" />
            <Switch x:Name="SwitchInvert" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button x:Name="BtnOk" Text="OK" Clicked="OnOkClicked" />
                <Button x:Name="BtnCancel" Text="Cancel" Clicked="OnCancelClicked" Grid.Column="1" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

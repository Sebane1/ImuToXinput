<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImuToXInput.Maui.TriggerConditionValuesPage"
             Title="Trigger output values">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="When condition true (0–255)" />
            <Entry x:Name="EntryWhenTrue" Keyboard="Numeric" Placeholder="255" />
            <Label Text="When condition false (0–255)" />
            <Entry x:Name="EntryWhenFalse" Keyboard="Numeric" Placeholder="0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button x:Name="BtnOk" Text="OK" Clicked="OnOkClicked" />
                <Button x:Name="BtnCancel" Text="Cancel" Clicked="OnCancelClicked" Grid.Column="1" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
